{
  "manifest_version": 3,
  "name": "Jucite Connector",
  "version": "1.0",
  "description": "Save academic papers directly to your local Jucite database.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8080/*"],
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  }
}