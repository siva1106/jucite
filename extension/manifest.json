{
  "manifest_version": 3,
  "name": "Jucite Connector",
  "version": "1.0",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8080/*"],
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["google-docs-injector.js"]
    }
  ],
  "action": { "default_popup": "popup.html" }
}