<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" 
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
           xsi:type="TaskPaneApp">
  
  <!-- Unique GUID for Jucite -->
  <Id>6f8e21a4-9843-4c12-9c3f-7e8932b51903</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Jucite</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  
  <!-- Mandatory Display Properties -->
  <DisplayName DefaultValue="Jucite Citation Manager" />
  <Description DefaultValue="Academic reference manager and citation suite for Microsoft Word." />
  <IconUrl DefaultValue="https://raw.githubusercontent.com/citation-style-language/styles/master/logo.png" />
  <HighResolutionIconUrl DefaultValue="https://raw.githubusercontent.com/citation-style-language/styles/master/logo.png" />
  <SupportUrl DefaultValue="https://github.com/citation-style-language/styles" />
  
  <!-- Approved Domains -->
  <AppDomains>
    <AppDomain>https://127.0.0.1:8080</AppDomain>
    <AppDomain>https://localhost:8080</AppDomain>
  </AppDomains>
  
  <!-- Target Host -->
  <Hosts>
    <Host Name="Document" />
  </Hosts>
  
  <!-- Main Taskpane Location (Strict HTTPS Required by Microsoft!) -->
  <DefaultSettings>
    <SourceLocation DefaultValue="https://127.0.0.1:8080/word" />
  </DefaultSettings>
  
  <!-- Document Edit Permissions -->
  <Permissions>ReadWriteDocument</Permissions>

</OfficeApp>